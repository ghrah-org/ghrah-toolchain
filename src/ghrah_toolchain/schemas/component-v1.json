{
  "type": "object",
  "properties": {
    "schema": {
      "type": "integer",
      "const": 1
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "platforms": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "build": {
      "type": "object",
      "properties": {
        "backend": {
          "enum": [
            "uv",
            "pnpm",
            "prebuilt"
          ]
        },
        "member": {
          "type": "string",
          "minLength": 1
        },
        "native_lock": {
          "type": "string",
          "minLength": 1
        },
        "depends_on": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "outputs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      },
      "required": [
        "backend",
        "outputs"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "backend": {
                "enum": [
                  "uv",
                  "pnpm"
                ]
              }
            }
          },
          "then": {
            "required": [
              "member"
            ]
          }
        }
      ]
    },
    "tests": {
      "type": "object",
      "properties": {
        "argv": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "cwd": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "argv"
      ],
      "additionalProperties": false
    },
    "entries": {
      "type": "object",
      "patternProperties": {
        "^[a-zA-Z0-9][a-zA-Z0-9_.-]*$": {
          "type": "object",
          "properties": {
            "kind": {
              "enum": [
                "process",
                "in-process",
                "container"
              ]
            },
            "argv": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "minItems": 1
            },
            "handler": {
              "type": "string",
              "minLength": 1
            },
            "transport": {
              "enum": [
                "none",
                "in-process",
                "stdio-jsonrpc",
                "uds-jsonrpc",
                "http",
                "mcp"
              ]
            },
            "ready": {
              "type": "object",
              "properties": {
                "type": {
                  "enum": [
                    "http",
                    "tcp",
                    "protocol",
                    "handshake",
                    "process"
                  ]
                },
                "path": {
                  "type": "string",
                  "minLength": 1
                },
                "method": {
                  "type": "string",
                  "minLength": 1
                },
                "contract": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "type"
              ],
              "additionalProperties": false
            },
            "health": {
              "type": "object",
              "properties": {
                "type": {
                  "enum": [
                    "http",
                    "tcp",
                    "protocol",
                    "handshake",
                    "process"
                  ]
                },
                "path": {
                  "type": "string",
                  "minLength": 1
                },
                "method": {
                  "type": "string",
                  "minLength": 1
                },
                "contract": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "type"
              ],
              "additionalProperties": false
            },
            "after": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "uniqueItems": true
            },
            "requires_ready": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "uniqueItems": true
            }
          },
          "required": [
            "kind"
          ],
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "exports": {
      "type": "object",
      "patternProperties": {
        "^[a-zA-Z0-9][a-zA-Z0-9_.-]*$": {
          "type": "object",
          "properties": {
            "scheme": {
              "const": "ability"
            },
            "contract": {
              "type": "string",
              "minLength": 1
            },
            "descriptor": {
              "type": "string",
              "minLength": 1
            },
            "entry": {
              "type": "string",
              "minLength": 1
            },
            "definition": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "scheme",
            "contract",
            "descriptor",
            "entry",
            "definition"
          ],
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "imports": {
      "type": "object",
      "patternProperties": {
        "^[a-zA-Z0-9][a-zA-Z0-9_.-]*$": {
          "type": "object",
          "properties": {
            "contract": {
              "type": "string",
              "minLength": 1
            },
            "required": {
              "type": "boolean"
            }
          },
          "required": [
            "contract"
          ],
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "host_requirements": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    }
  },
  "required": [
    "schema",
    "id",
    "version"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
