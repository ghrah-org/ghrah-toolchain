{
  "type": "object",
  "properties": {
    "schema": {
      "type": "integer",
      "const": 1
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "platforms": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "build": {
      "type": "object",
      "properties": {
        "backend": {
          "enum": [
            "uv",
            "pnpm",
            "prebuilt"
          ]
        },
        "member": {
          "type": "string",
          "minLength": 1
        },
        "native_lock": {
          "type": "string",
          "minLength": 1
        },
        "depends_on": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "outputs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      },
      "required": [
        "backend",
        "outputs"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "backend": {
                "enum": [
                  "uv",
                  "pnpm"
                ]
              }
            }
          },
          "then": {
            "required": [
              "member"
            ]
          }
        }
      ]
    },
    "tests": {
      "type": "object",
      "properties": {
        "argv": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "cwd": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "argv"
      ],
      "additionalProperties": false
    },
    "entries": {
      "type": "object",
      "patternProperties": {
        "^[a-zA-Z0-9][a-zA-Z0-9_.-]*$": {
          "type": "object",
          "properties": {
            "kind": {
              "enum": [
                "process",
                "in-process",
                "container"
              ]
            },
            "argv": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "minItems": 1
            },
            "handler": {
              "type": "string",
              "minLength": 1
            },
            "transport": {
              "enum": [
                "none",
                "in-process",
                "stdio-jsonrpc",
                "uds-jsonrpc",
                "http",
                "mcp"
              ]
            },
            "ready": {
              "type": "object",
              "properties": {
                "type": {
                  "enum": [
                    "http",
                    "tcp",
                    "protocol",
                    "handshake",
                    "process"
                  ]
                },
                "path": {
                  "type": "string",
                  "minLength": 1
                },
                "method": {
                  "type": "string",
                  "minLength": 1
                },
                "contract": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "type"
              ],
              "additionalProperties": false
            },
            "health": {
              "type": "object",
              "properties": {
                "type": {
                  "enum": [
                    "http",
                    "tcp",
                    "protocol",
                    "handshake",
                    "process"
                  ]
                },
                "path": {
                  "type": "string",
                  "minLength": 1
                },
                "method": {
                  "type": "string",
                  "minLength": 1
                },
                "contract": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "type"
              ],
              "additionalProperties": false
            },
            "after": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "uniqueItems": true
            },
            "requires_ready": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "uniqueItems": true
            }
          },
          "required": [
            "kind"
          ],
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "exports": {
      "type": "object",
      "patternProperties": {
        "^[a-zA-Z0-9][a-zA-Z0-9_.-]*$": {
          "type": "object",
          "properties": {
            "scheme": {
              "const": "ability"
            },
            "contract": {
              "type": "string",
              "minLength": 1
            },
            "descriptor": {
              "type": "string",
              "minLength": 1
            },
            "entry": {
              "type": "string",
              "minLength": 1
            },
            "definition": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "scheme",
            "contract",
            "descriptor",
            "entry",
            "definition"
          ],
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "imports": {
      "type": "object",
      "patternProperties": {
        "^[a-zA-Z0-9][a-zA-Z0-9_.-]*$": {
          "type": "object",
          "properties": {
            "contract": {
              "type": "string",
              "minLength": 1
            },
            "required": {
              "type": "boolean"
            }
          },
          "required": [
            "contract"
          ],
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "host_requirements": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "providers": {
      "type": "object",
      "patternProperties": {
        "^[a-z][a-z0-9-]*$": {
          "type": "object",
          "properties": {
            "module": {
              "type": "string",
              "minLength": 1
            },
            "provider": {
              "type": "string",
              "minLength": 1
            },
            "kind": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]*$"
            },
            "order": {
              "type": "integer",
              "minimum": 0
            },
            "after": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "uniqueItems": true
            },
            "requires_ready": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "uniqueItems": true
            },
            "restart": {
              "enum": [
                "never",
                "on_failure",
                "always"
              ]
            },
            "max_restarts": {
              "type": "integer",
              "minimum": 0,
              "maximum": 3
            },
            "window_seconds": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 60
            },
            "drain_ms": {
              "type": "integer",
              "minimum": 0,
              "maximum": 500
            },
            "close_timeout_ms": {
              "type": "integer",
              "minimum": 1,
              "maximum": 2000
            },
            "close_action": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "minItems": 2,
              "maxItems": 2
            },
            "ready": {
              "$ref": "#/$defs/probe"
            },
            "health": {
              "$ref": "#/$defs/probe"
            },
            "configuration": {
              "type": "string",
              "minLength": 1
            },
            "schemes": {
              "type": "object",
              "minProperties": 1,
              "patternProperties": {
                "^[a-z][a-z0-9-]*$": {
                  "type": "object",
                  "properties": {
                    "contract": {
                      "type": "string",
                      "minLength": 1
                    },
                    "actions": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "minLength": 1
                      },
                      "minItems": 1,
                      "uniqueItems": true
                    }
                  },
                  "required": [
                    "contract",
                    "actions"
                  ],
                  "additionalProperties": false
                }
              },
              "additionalProperties": false
            },
            "bindings": {
              "type": "object",
              "patternProperties": {
                "^[a-z][a-z0-9-]*$": {
                  "type": "object",
                  "properties": {
                    "path": {
                      "type": "string",
                      "pattern": "^/"
                    },
                    "scheme": {
                      "type": "string",
                      "minLength": 1
                    },
                    "scope": {
                      "type": "string",
                      "minLength": 1
                    },
                    "namespace": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "required": [
                    "path",
                    "scheme",
                    "scope",
                    "namespace"
                  ],
                  "additionalProperties": false
                }
              },
              "additionalProperties": false
            }
          },
          "required": [
            "module",
            "provider",
            "kind",
            "schemes"
          ],
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "kernel": {
      "type": "object",
      "properties": {
        "module": {
          "type": "string",
          "pattern": "^[A-Za-z_]\\w*(\\.[A-Za-z_]\\w*)*$"
        },
        "entry": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_-]*$"
        }
      },
      "required": [
        "module",
        "entry"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema",
    "id",
    "version"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "probe": {
      "type": "object",
      "properties": {
        "type": {
          "enum": [
            "handshake",
            "protocol"
          ]
        },
        "contract": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "type",
        "contract"
      ],
      "additionalProperties": false
    }
  }
}
